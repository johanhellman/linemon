# /etc/linemon/linemon.conf (example: copy it there and edit what you need)
#
# Every setting is optional and shown here with its default, so an empty or missing
# file behaves exactly like linemon without one. Command-line arguments (including
# LINEMON_ARGS in /etc/default/linemon) override this file, which overrides the
# defaults. Unknown settings are an error, so a typo can't silently do nothing.
#
# This file holds no secrets and is safe to paste into a bug report. Anything secret
# lives in its own file readable by root only (see router.conf), never here.
#
# Changes take effect when the monitor restarts: sudo systemctl restart linemon.
# Check a file first with: sudo /opt/linemon/linemon.py --check-config

[monitor]
# Wired interface connected to the ISP router. Probes never leave through another one.
iface = eth0
# Where events.csv, minute.csv, captures.jsonl and path.log are written.
data = /var/lib/linemon
# Seconds between probes per target.
interval = 1.0
# Consecutive failed probes before a target counts as down.
threshold = 3

[hook]
# Command that captures the ISP router's own status (empty or missing = off).
# command = /opt/linemon/routers/zte_livebox.py
# Seconds between captures during an outage.
during = 30
# Seconds between periodic captures while the line is up (0 = only around outages).
interval = 300
# Seconds before a capture is abandoned.
timeout = 30

[health]
# linemon watches its own health every 15 seconds and writes it to health.json. Time when it
# can't trust its own measurements is recorded in events.csv as unhealthy, and counts as unknown.
#
# Seconds a thread may go without progress before it counts as stalled (a probe takes about a second).
stall = 30
# Seconds the clock may jump, compared with the monotonic clock, before measurements are unreliable.
clock_step = 2.0
# Seconds the clock may stay unsynchronised (NTP) before measurements are unreliable.
ntp_grace = 600
# Free megabytes in the data directory below which health is degraded...
disk_warn = 1000
# ...and below which measurements are unreliable (writes are about to fail).
disk_critical = 100
