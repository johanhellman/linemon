[Unit]
Description=Internet line monitor (linemon)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
ExecStart=/usr/bin/python3 /opt/linemon/linemon.py --iface eth0 --data /var/lib/linemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
